+def _client_tool_named(source: dict, name: str, kind: str) -> str | None:
+    allowed = client_tool_types(source)
+    for key, leaf, _namespace, tool_type, _tool in _iter_client_tools(source.get("tools")):
+        if leaf == name and tool_type == kind and key in allowed:
+            return key
