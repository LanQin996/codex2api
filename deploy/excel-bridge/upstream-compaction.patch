+def _client_tool_transport_example(source: dict) -> str:
+    allowed = client_tool_types(source)
+    exec_name = _client_tool_named(source, "exec", "custom")
+    if exec_name:
+        return json.dumps({"name": exec_name, "input":
+            "text(ALL_TOOLS.filter(t => /exec_command|shell_command|apply_patch/.test(t.name)));"},
+            separators=(",", ":"))
+    for name in ("exec_command", "shell_command"):
+        actual_name = _client_tool_named(source, name, "function")
+        if actual_name:
+            field = "cmd" if name == "exec_command" else "command"
+            return json.dumps({"name": actual_name, "arguments": {field: "pwd"}},
+                              separators=(",", ":"))
+    return "Use an exact tool name and schema from the current catalog."
