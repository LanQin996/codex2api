+    if not isinstance(response, dict):
+        raise ValueError("invalid_response_payload")
+    status = response.get("status")
+    if status in ("failed", "incomplete", "cancelled", "in_progress", "queued"):
+        return _excel_without_tool_calls(response), []
+    if status != "completed":
+        raise ValueError("missing_or_invalid_response_status")
