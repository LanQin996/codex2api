+def _excel_convert_native_batch(response, source):
+    if response.get("status") != "completed":
+        raise ValueError("response_not_completed")
+    output = response.get("output", [])
+    if not isinstance(output, list):
+        raise ValueError("invalid_response_output")
+    natives = [(i, x) for i, x in enumerate(output) if isinstance(x, dict) and
+               x.get("type") in {"function_call", "custom_tool_call"}]
+    ids = [x.get("call_id") for _, x in natives]
+    if any(not isinstance(x, str) or not x for x in ids) or len(set(ids)) != len(ids):
+        raise ValueError("invalid_or_duplicate_call_id")
+    if len(natives) > 1 and source.get("parallel_tool_calls") is False:
+        raise ValueError("parallel_calls_disabled")
+    converted = []
+    for index, native in natives:
+        if native.get("status") not in (None, "completed"):
+            raise ValueError("tool_not_completed")
+        call = excel_upstream.extract_native_client_tool_call(
+            {"output": [native]}, source, remember=False)
+        if call is None:
+            raise ValueError("catalog_or_schema_mismatch")
+        converted.append((index, call))
+    translated = dict(response)
+    translated["output"] = list(output)
+    for index, call in converted:
+        translated["output"][index] = {**call, "status": "completed"}
+    # Commit only after the entire batch satisfies the client contract.
+    for _, native in natives:
+        excel_upstream._remember_native_call(native)
+    return translated, converted
+
+
+def _excel_without_tool_calls(response):
+    safe = dict(response)
